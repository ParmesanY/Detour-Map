{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detour-map-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Request logs would hold client IPs: keep Workers Logs off.
  "observability": { "enabled": false },
  // The map site (site/public) is served from the same origin; /v1/* always reaches the Worker.
  "assets": {
    "directory": "../site/public",
    "run_worker_first": ["/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "detour-map",
      "database_id": "38ac1ea5-2121-47e0-a280-ed312b1d600a",
      "migrations_dir": "migrations"
    }
  ],
  // Rebuilds today's and yesterday's aggregates, clears pseudonyms and old reports.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // A cell (target × ISP × region × day) is shown only with at least this many distinct reporters.
    "MIN_REPORTERS": "3",
    // Reports per pseudonym (≈ one IP) per hour.
    "RATE_LIMIT_PER_HOUR": "6",
    // Edge cache of the read API, seconds (0 = off).
    "CACHE_SECONDS": "120"
  }
}
