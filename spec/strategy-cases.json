{
  "cases": [
    {
      "name": "context args are dropped, desync args sorted by name",
      "engine": "winws",
      "args": "--filter-tcp=443 --hostlist-domains=rutracker.org --dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync-fake-tls=\"%BIN%tls_clienthello_www_google_com.bin\"",
      "key": "winws:--dpi-desync=fake --dpi-desync-fake-tls=%BIN%tls_clienthello_www_google_com.bin --dpi-desync-fooling=ts --dpi-desync-repeats=6"
    },
    {
      "name": "same flags in another order give the same key",
      "engine": "winws",
      "args": "--dpi-desync-repeats=6 --dpi-desync-fooling=ts --dpi-desync=fake --dpi-desync-fake-tls=%BIN%tls_clienthello_www_google_com.bin",
      "key": "winws:--dpi-desync=fake --dpi-desync-fake-tls=%BIN%tls_clienthello_www_google_com.bin --dpi-desync-fooling=ts --dpi-desync-repeats=6"
    },
    {
      "name": "a full path becomes %BIN% plus the file name; .bat escapes go",
      "engine": "winws",
      "args": "--wf-iface=12 --wf-tcp=443 --DPI-Desync=fake --dpi-desync-fake-tls=\"C:\\zapret\\bin\\tls_clienthello_4pda_to.bin\" --dpi-desync-fake-tls=^!",
      "key": "winws:--dpi-desync=fake --dpi-desync-fake-tls=%BIN%tls_clienthello_4pda_to.bin --dpi-desync-fake-tls=!"
    },
    {
      "name": "repeated flags keep their relative order",
      "engine": "winws",
      "args": "--dpi-desync-fake-tls=0x00000000 --dpi-desync=fake,multidisorder --dpi-desync-fake-tls=! --dpi-desync-split-pos=1,midsld",
      "key": "winws:--dpi-desync=fake,multidisorder --dpi-desync-fake-tls=0x00000000 --dpi-desync-fake-tls=! --dpi-desync-split-pos=1,midsld"
    },
    {
      "name": "options that write files or read lists are refused",
      "engine": "winws",
      "args": "--dpi-desync=fake --debug=@C:\\log.txt",
      "error": "option"
    },
    {
      "name": "a file that isn't a .bin is refused",
      "engine": "winws",
      "args": "--dpi-desync=fake --dpi-desync-fake-tls=%BIN%..\\..\\windows\\system.ini",
      "error": "value"
    },
    {
      "name": "nothing left after dropping the context",
      "engine": "winws",
      "args": "--filter-tcp=443 --hostlist-domains=x.com",
      "error": "empty"
    },
    {
      "name": "ByeDPI: the binary and listen/bind options go, order stays, values attach",
      "engine": "byedpi",
      "args": "ciadpi.exe -i 127.0.0.1 -p 1080 -I 192.168.1.10 -r 1+s -s1",
      "key": "byedpi:-r1+s -s1"
    },
    {
      "name": "ByeDPI long options become short ones",
      "engine": "byedpi",
      "args": "--disorder 1 --fake 1+s --ttl 5 --md5sig",
      "key": "byedpi:-d1 -f1+s -t5 -S"
    },
    {
      "name": "ByeDPI order matters",
      "engine": "byedpi",
      "args": "-s1 -r1+s",
      "key": "byedpi:-s1 -r1+s"
    },
    {
      "name": "ByeDPI unknown option is refused",
      "engine": "byedpi",
      "args": "-s1 -Z7",
      "error": "option"
    },
    {
      "name": "unknown engine",
      "engine": "goodbyedpi",
      "args": "-5",
      "error": "engine"
    }
  ]
}
